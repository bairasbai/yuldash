# Порог покрытия бэкенда — «храповик»: опускаться нельзя, поднимать можно.
#
# Зачем порог вообще. Покрытие без порога — это цифра в отчёте, на которую никто не смотрит.
# Порог превращает её в правило: если новый код пришёл без тестов и общая доля упала ниже
# планки, команда `coverage report` возвращает ненулевой код и сборка краснеет.
#
# Почему 85, а не 100. На 2026-08-04 фактическое покрытие бэкенда — 89%. Планка ставится
# чуть ниже достигнутого: она ловит откат, но не заставляет писать пустые тесты ради цифры.
# Дорасли до 92 — подняли планку до 90. Обратно не опускаем.
#
# Как гонять:
#   cd backend
#   python -m coverage run --source=app -m pytest -q
#   python -m coverage report        # покажет таблицу и упадёт, если ниже планки
#   python -m coverage html          # подробный отчёт по строкам → htmlcov/index.html

[run]
source = app
branch = False
omit =
    app/__init__.py
    # Скрипты миграций Alembic — их «покрывает» реальный прогон на копии базы, а не unit-тесты.
    app/migrations/*

[report]
fail_under = 85
precision = 1
skip_covered = False
show_missing = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    # Защитные ветки «этого не должно случиться» — их незакрытость не риск, а норма.
    except ImportError:
