# Скопируй в .env и заполни. .env НЕ коммитим (см .gitignore).
ENV=dev
# dev: SQLite-файл рядом. prod: postgresql://user:pass@host:5432/yuldash
DATABASE_URL=sqlite:///./yuldash.db
# Длинная случайная строка. На сервере сгенерируй свою: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=43200
OTP_TTL_SEC=300
# SMS-провайдер (Фаза 1 — мок, код пишется в лог). Ключи добавим, когда подключим реальный SMS.
SMS_PROVIDER=mock
