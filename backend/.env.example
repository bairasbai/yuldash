# Скопируй в .env и заполни. .env НЕ коммитим (см .gitignore).

# dev | prod. В prod включается строгая проверка конфигурации (validate_production).
ENV=dev

# dev: SQLite-файл рядом. prod: postgresql://user:pass@host:5432/yuldash
DATABASE_URL=sqlite:///./yuldash.db

# Длинная случайная строка. На сервере сгенерируй свою:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# В prod значение dev-secret-change-me и строки короче 16 символов запрещены.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=43200
OTP_TTL_SEC=300

# SMS-провайдер. mock — код в лог (dev). smsru — реальная отправка через sms.ru.
# В prod 'mock' запрещён.
SMS_PROVIDER=mock
# Для реального SMS: зарегистрируйся на sms.ru, возьми api_id в кабинете, поставь
# SMS_PROVIDER=smsru и впиши ключ сюда (в .env на сервере, не в git).
SMS_RU_API_ID=
# Буквенный отправитель sms.ru после модерации (например, Yuldash). Можно оставить пустым.
SMS_FROM=

# База для публичных URL медиа (фото/голос). В prod должен быть публичный HTTPS
# (http://, localhost, 127.0.0.1 запрещены).
MEDIA_BASE_URL=https://yulbash.ru

# Список разрешённых CORS origin через запятую. В prod '*' запрещён,
# укажи конкретные домены, напр.: https://yulbash.ru,https://www.yulbash.ru
CORS_ORIGINS=*

# Демо-поездки в пустой БД и тестовые объявления. В prod выключи (false).
SEED_DEMO=true

# Лимит размера загрузки (фото/аудио) в мегабайтах.
MAX_UPLOAD_MB=10
# Разрешённые расширения файлов (через запятую).
ALLOWED_IMAGE_EXT=jpg,jpeg,png,webp
ALLOWED_AUDIO_EXT=m4a,mp3,ogg,wav,aac