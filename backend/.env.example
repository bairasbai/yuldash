# Скопируй в .env и заполни. .env НЕ коммитим (см .gitignore).

# dev | prod. В prod включается строгая проверка конфигурации (validate_production).
ENV=dev

# dev: SQLite-файл рядом. prod: postgresql://user:pass@host:5432/yuldash
DATABASE_URL=sqlite:///./yuldash.db

# Длинная случайная строка. На сервере сгенерируй свою:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# В prod значение dev-secret-change-me и строки короче 16 символов запрещены.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=43200
OTP_TTL_SEC=300

# SMS-провайдер. mock — код в лог (dev). smsru — реальная отправка через sms.ru.
# В prod 'mock' запрещён.
SMS_PROVIDER=mock
# Для реального SMS: зарегистрируйся на sms.ru, возьми api_id в кабинете, поставь
# SMS_PROVIDER=smsru и впиши ключ сюда (в .env на сервере, не в git).
SMS_RU_API_ID=
# Буквенный отправитель sms.ru после модерации (например, Yuldash). Можно оставить пустым.
SMS_FROM=

# --- Яндекс.Геокодер (поиск адресов «Откуда/Куда») ---
# Ключ HTTP-геокодера Яндекса. Клиент ходит на наш /geocode, ключ держим ЗДЕСЬ (не в APK).
# Пусто → /geocode вернёт пустой список (подсказок адресов не будет, но приложение работает).
YANDEX_GEOCODER_KEY=

# --- Авто-проверка водителей (OCR прав, Yandex Vision ~0,13 ₽/фото) ---
# Сервер сам читает права при отправке документов и помечает заявку. Снижает ручную
# работу админа. Без ключа OCR (ниже) проверка просто отдаёт заявку человеку.
DRIVER_AUTOCHECK_ENABLED=true
# Авто-отказ ТОЛЬКО на явный мусор (пустое/нечитаемое фото). Сомнительное → к человеку.
DRIVER_AUTOREJECT_ENABLED=true
# Авто-одобрение при высокой уверенности. По умолчанию ВЫКЛ — финальную кнопку жмёт админ.
# Включать только когда доверишься качеству OCR. В prod требует YANDEX_VISION_KEY.
DRIVER_AUTOAPPROVE_ENABLED=false
DRIVER_AUTOCHECK_MIN_SCORE=0.75
# Ключ Yandex Vision OCR: проще всего в AI Studio (aistudio.yandex.ru) → «Создать API-ключ».
# Держим ЗДЕСЬ (не в APK, не в git). Пусто → OCR выключен, все заявки идут к человеку.
YANDEX_VISION_KEY=
# Folder ID — ОПЦИОНАЛЬНО: нужен только для ключей сервис-аккаунта. Ключ AI Studio
# привязан к каталогу и работает без него (проверено вживую). Если ключ SA — впиши b1g…
YANDEX_VISION_FOLDER_ID=

# --- Авто-подбор водителя для «помощь»-заявок (пассажир БЕЗ приложения) ---
# Заявку от человека без приложения (по звонку/за пожилого) раньше принимал админ вручную.
# С включённым флагом система сама берёт ЛУЧШИЙ отклик (рейтинг→цена) через паузу ниже.
# Заявки от пользователей С приложением НЕ трогает — там водителя выбирает сам пассажир.
# Работает через systemd-таймер (deploy/yuldash-automatch.*), запускающий `python -m app.automatch`.
AUTOMATCH_ENABLED=true
# Пауза (сек) после первого отклика — дать откликнуться другим, чтобы выбрать лучшего.
AUTOMATCH_GRACE_SEC=120

# --- Telegram-вход (бот) ---
# 1) Создай бота у @BotFather → токен вида 123456:ABC-... → впиши сюда.
# 2) Придумай длинный секрет вебхука (любая случайная строка).
# 3) Зарегистрируй вебхук один раз (подставь свой токен и секрет):
#    curl "https://api.telegram.org/bot<ТОКЕН>/setWebhook?url=https://yulbash.ru/telegram/webhook&secret_token=<СЕКРЕТ>"
# Пусто → кнопка «Войти через Telegram» показывает «скоро».
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Push (FCM) ---
# Путь к JSON сервисного аккаунта Firebase (Настройки проекта → Сервисные аккаунты → создать ключ).
# Пусто → push выключен (сервер не падает). Файл НЕ в git.
FIREBASE_CREDENTIALS=

# --- Web Push (уведомления в браузер) ---
# Firebase доставляет только в приложение из магазина. Человеку, открывшему сайт,
# уведомления идут этим путём. Пусто → канал выключен, ошибок не будет.
#
# Пару ключей сгенерировать один раз:
#   npx web-push generate-vapid-keys
# Публичный ОБЯЗАН совпадать с VITE_VAPID_PUBLIC_KEY в webapp/.env — иначе браузер
# подпишется на одного отправителя, а слать будет другой, и уведомления не дойдут.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Контакт отправителя для пуш-сервисов: без него Apple и часть браузеров отклоняют отправку.
VAPID_SUBJECT=mailto:support@yulbash.ru

# База для публичных URL медиа (фото/голос). В prod должен быть публичный HTTPS
# (http://, localhost, 127.0.0.1 запрещены).
MEDIA_BASE_URL=https://yulbash.ru

# --- Хранилище медиа: диск сервера (по умолчанию) или облако S3 ---
# Пусто → авто: если заданы S3_BUCKET + оба ключа, включаем облако; иначе локальный диск
# (как раньше, полный фолбэк). Явно: local | s3. Секреты ниже — НЕ коммить в git.
STORAGE_BACKEND=
S3_ENDPOINT_URL=      # endpoint S3-совместимого хранилища (Timeweb/VK Cloud/Selectel). Пусто → AWS.
S3_REGION=            # регион бакета, напр. ru-1 (опционально)
S3_BUCKET=            # имя бакета
S3_ACCESS_KEY=        # Access Key ID
S3_SECRET_KEY=        # Secret Access Key
S3_SIGNED_URL_TTL=3600  # TTL подписанного (presigned) URL, сек

# Список разрешённых CORS origin через запятую. В prod '*' запрещён,
# укажи конкретные домены, напр.: https://yulbash.ru,https://www.yulbash.ru
CORS_ORIGINS=*

# Демо-поездки в пустой БД и тестовые объявления. В prod выключи (false).
SEED_DEMO=true

# --- Анти-абуз: глобальный лимит запросов на IP (важно перед публичным запуском) ---
RATE_LIMIT_ENABLED=true
# Общий лимит запросов/мин с одного IP (обычный клиент сильно ниже).
RATE_LIMIT_PER_MIN=300
# Строгий лимит на /auth/* и /sos (анти-перебор кодов / спам SOS).
RATE_LIMIT_AUTH_PER_MIN=20
# Redis для общего лимита на все воркеры/серверы. Пусто → in-memory (на воркер).
# Прод: redis://127.0.0.1:6379/0 (нужен redis-server + redis-py в venv).
REDIS_URL=

# --- Токены ---
# Access живёт коротко (refresh обновляет его без перелогина); refresh ротируется.
ACCESS_EXPIRE_MIN=720          # 12ч, как в коде; НЕ ставь 7 дней — это ~14x шире окно кражи токена
REFRESH_EXPIRE_DAYS=90

# Лимит размера загрузки (фото/аудио) в мегабайтах.
MAX_UPLOAD_MB=10
# Лимит загрузок на юзера в сутки (анти disk-fill / спам).
MAX_UPLOADS_PER_DAY=60
# Разрешённые расширения файлов (через запятую).
ALLOWED_IMAGE_EXT=jpg,jpeg,png,webp
ALLOWED_AUDIO_EXT=m4a,mp3,ogg,wav,aac

# --- Платежи (самозанятый: монетизация СВОИХ услуг — Boost/реклама) ---
# mock — платёж сразу «оплачен» (только dev).
# sbp_manual — перевод по СБП на номер, активирует админ вручную (интерим до ЮKassa).
# yookassa — авто-приём + авто-чек (нужны ключи). В prod при yookassa ключи обязательны.
PAYMENTS_PROVIDER=mock
# --- ЮKassa (когда приложение опубликовано и подключён эквайринг) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=https://yulbash.ru/pay/done
# Вебхук ЮKassa регистрируется один раз (payment.succeeded):
#   https://yulbash.ru/payments/yookassa/webhook
# --- СБП-перевод по номеру (интерим, PAYMENTS_PROVIDER=sbp_manual). Перс.данные — НЕ в git! ---
# При sbp_manual SBP_PHONE обязателен (иначе старт запрещён).
SBP_PHONE=
SBP_BANK=
SBP_NAME=