[Unit]
Description=Reconcile admitted Yuldash rideshare bank operations
After=network.target postgresql.service

[Service]
Type=oneshot
User=yuldash
WorkingDirectory=/opt/yuldash
EnvironmentFile=-/opt/yuldash/.env
ExecStart=/opt/yuldash/.venv/bin/python -m app.rideshare_bank_worker
TimeoutStartSec=120
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
