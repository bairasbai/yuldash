# Юлдаш nginx — фрагмент для масштаба (Фаза 5): upstream с несколькими воркерами
# и ip_hash-стикинг для WebSocket (чат /ws/bookings, карта /ws/map, трек /ws/trip).
#
# Это ПРИМЕР-ФРАГМЕНТ, не полный конфиг. Действующий конфиг — /etc/nginx/sites-available/yuldash
# (см. docs/server.md): лендинг на /, всё API проксируется в @api → 127.0.0.1:8000.
# Здесь показано, ЧТО добавить/поменять, когда воркеров станет несколько.
#
# ┌─ Важно про ip_hash и WebSocket ─────────────────────────────────────────────┐
# │ Сейчас все воркеры на одном хосте (127.0.0.1:8000) под мастером gunicorn —    │
# │ nginx проксирует на ОДИН порт, распределение по воркерам делает сам gunicorn. │
# │ ip_hash в upstream нужен, КОГДА появятся несколько АДРЕСОВ бэкенда (несколько  │
# │ машин или несколько gunicorn-мастеров на разных портах): тогда ip_hash        │
# │ «прибивает» клиента к одному апстриму → его WS-сессия живёт на одном процессе. │
# │                                                                              │
# │ ВАЖНО: строгая липкость для WS не обязательна для корректности — события      │
# │ между воркерами/хостами уже разносит Redis pub/sub (app/services.py:          │
# │ _CHAT_CHANNEL, publish/subscribe). ip_hash здесь — оптимизация (меньше        │
# │ переустановок соединения и ребаланса), а не условие работы чата.              │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- (1) upstream: несколько адресов бэкенда со стикингом по IP клиента ---
# Пример для сценария «2 gunicorn-мастера на разных портах» или «2 app-хоста».
# Для одного мастера на 127.0.0.1:8000 upstream не нужен — оставь прямой proxy_pass.
upstream yuldash_api {
    ip_hash;                       # клиент всегда попадает на тот же апстрим (WS-стикинг)
    server 127.0.0.1:8000 max_fails=3 fail_timeout=10s;
    # server 127.0.0.1:8001 max_fails=3 fail_timeout=10s;      # второй мастер (пример)
    # server 10.0.0.12:8000  max_fails=3 fail_timeout=10s;     # второй app-хост (пример)
    keepalive 32;                  # пул keep-alive соединений к бэкенду (меньше overhead)
}

# --- (2) карта апгрейда WS (обычно уже есть в /etc/nginx/conf.d/ws_upgrade.conf) ---
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

# --- (3) как проксировать: заменить в @api адрес на upstream ---
# Внутри location @api { ... } (см. текущий конфиг) меняем proxy_pass:
#
#   location @api {
#       proxy_pass http://yuldash_api;              # было: http://127.0.0.1:8000
#       proxy_http_version 1.1;
#       proxy_set_header Host $host;
#       proxy_set_header X-Real-IP $remote_addr;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       # WebSocket upgrade (чат/карта/трек):
#       proxy_set_header Upgrade $http_upgrade;
#       proxy_set_header Connection $connection_upgrade;
#       proxy_read_timeout 3600s;                   # долгие WS-соединения не рвём
#       proxy_send_timeout 3600s;
#   }
#
# ВАЖНО про ip_hash за прокси/CDN: ip_hash смотрит на $remote_addr. Если перед nginx
# стоит ещё один прокси/балансировщик — все клиенты придут с одного IP и стикинг сломается.
# В таком случае бери реальный IP из X-Forwarded-For (real_ip_module: set_real_ip_from + real_ip_header)
# ИЛИ переходи на hash по заголовку/куке. У нас сейчас nginx — крайняя точка, $remote_addr корректен.
