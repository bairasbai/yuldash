[Unit]
Description=Yuldash driver document check (warn before expiry, suspend taxi access after, restore on renewal)
After=network.target postgresql.service

[Service]
Type=oneshot
User=yuldash
WorkingDirectory=/opt/yuldash
# Явный EnvironmentFile (как у остальных юнитов): без него задача живёт на pydantic-.env из CWD
# и при переезде layout'а молча ушла бы на дефолтный SQLite вместо прод-БД. «-» = нет файла → не падать.
EnvironmentFile=-/opt/yuldash/.env
ExecStart=/opt/yuldash/.venv/bin/python -m app.doc_check
Nice=10
