[Unit]
Description=Yuldash taxi worker (activate pre-orders, close stuck orders, retry search when no drivers)
After=network.target postgresql.service

[Service]
Type=oneshot
User=yuldash
WorkingDirectory=/opt/yuldash
# Явный EnvironmentFile (как у остальных юнитов): без него задача живёт на pydantic-.env из CWD
# и при переезде layout'а молча ушла бы на дефолтный SQLite вместо прод-БД. «-» = нет файла → не падать.
EnvironmentFile=-/opt/yuldash/.env
ExecStart=/opt/yuldash/.venv/bin/python -m app.taxi_worker
# Явный потолок времени прогона (аудит 2026-08-08, волна 199). Своего значения тут не было,
# то есть действовало умолчание systemd (обычно 90 с) — и никто про него не знал. Прогон ходит
# в сеть (пуши, SMS, Telegram) и разбирает до пятисот строк на задачу: затянулся — процесс
# убивают, а всё, что не успело выполниться, просто не выполняется. Тихо: пока прогон идёт,
# следующий тик таймера systemd пропускает, и в логе нет ни одной ошибки.
#
# Само по себе это число дыру не закрывает — её закрывает ПОРЯДОК задач в `app/taxi_worker.py`
# (сначала тревога и зимний протокол, потом хозяйство). Здесь мы лишь перестаём зависеть
# от умолчания дистрибутива и даём прогону разумный запас.
TimeoutStartSec=180
# Ограждение (аудит 2026-08-08, волна 130). Эти задачи ходят в интернет (Яндекс, Firebase,
# Telegram, ЮKassa) и разбирают чужие данные. Если через них однажды получится выполнить чужой
# код, он не должен мочь ничего, кроме своей работы:
#   NoNewPrivileges  — нельзя повысить права даже через suid-программы;
#   ProtectSystem    — /usr и /etc только на чтение;
#   ProtectHome      — домашних каталогов людей для него не существует;
#   PrivateTmp       — свой /tmp, чужие временные файлы не видны;
#   ReadWritePaths   — писать можно только в свой каталог (медиа, приватные файлы, логи).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/yuldash
Nice=10
