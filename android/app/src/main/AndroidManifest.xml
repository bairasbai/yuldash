<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Карта Яндекс MapKit грузит тайлы по сети -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Геолокация: понадобится для «моё местоположение» (запрашиваем в рантайме, после подтверждения поездки) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Запись голосовых сообщений -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Push-уведомления (FCM). На Android 13+ запрашивается в рантайме. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground-сервис live-позиции: слать GPS попутчику во время активной поездки (с погасшим экраном). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".YuldashApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Yuldash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Yuldash.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- F16: расшаренная ссылка на поездку yulbash.ru/r/{id} открывается в приложении.
                 autoVerify → Android проверит assetlinks.json на домене и будет открывать
                 ссылку сразу в Юлдаше (без диалога выбора). Отдельный filter, MAIN не трогает. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yulbash.ru" android:pathPrefix="/r/" />
                <data android:scheme="http" android:host="yulbash.ru" android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <!-- FCM: приём пушей. Работает после добавления google-services.json. -->
        <service
            android:name=".data.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="yuldash_default" />

        <!-- Foreground-сервис live-позиции в активной поездке. -->
        <service
            android:name=".TripLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
