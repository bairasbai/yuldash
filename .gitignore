# Codex/агент-конфиги с API-ключами (Stitch и пр.) — НЕ в git
.codex/

# strix (pentest-инструмент) — ставится в отдельный venv, в git НЕ коммитим
strix-src/
strix-venv/

# Android
android/.gradle/
android/local.properties
android/**/build/
android/captures/

# Kotlin / Gradle
.gradle/
build/

# Flutter, if mobile/ is used later again
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/
mobile/ios/

# IDE
.idea/
*.iml

# OS
Thumbs.db
.DS_Store

# Подпись / ключи — НИКОГДА не коммитить
*.jks
*.keystore
keystore.properties
# Собранные APK (тяжёлые бинарники ~50 МБ) — не в git, раздаём отдельно
*.apk
# Локальные приватные заметки агентов
backend/private/
# Firebase: конфиг приложения (ключ API) и сервисный ключ — не в git.
# Широкие паттерны: ловят ЛЮБОЕ имя сервис-ключа (adminsdk, serviceAccount,
# yuldash-<id>-firebase-adminsdk-*.json из консоли Firebase) — критичный админ-секрет.
android/app/google-services.json
**/google-services.json
**/firebase-service-account*.json
**/*firebase-adminsdk*.json
**/*adminsdk*.json
**/*serviceAccount*.json
**/*firebase*credentials*.json

# Backend (Python)
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.db
*.sqlite
*.sqlite3
.env
.env.*
# (.env.example — шаблон, остаётся в репо)
!.env.example

# Нативная сборка
**/.cxx/

# Временные скриншоты/дампы агентов (QA на эмуляторе)
_*.png
*.uix
# QA-артефакты в корне android/: скриншоты и uiautomator-дампы.
# (в gitignore «*» не пересекает «/», поэтому res/mipmap-иконки и app/src/**.xml НЕ затрагиваются)
/android/*.png
/android/*.xml
/android/*.json
# Промо (Remotion): игнорим только тяжёлое/сгенерированное, исходник остаётся в репо
promo/node_modules/
promo/out/
promo/.remotion/

# Playwright MCP артефакты (скриншоты/снапшоты)
.playwright-mcp/

# QA-скриншоты эмулятора (папка)
/android/screenshots/

# QA-артефакты тестирования (скриншоты, отчёты сборки)
test_artifacts/

# Временные файлы pytest (TMPDIR прогонов бэкенда) — не артефакт для git
backend/.pt/
.pt/
# Изоляция суб-агентов Claude Code (worktree) — локальные, не в git
.claude/worktrees/

# Замеры покрытия — артефакты прогона, а не исходник (пороги лежат в .coveragerc и build.gradle.kts)
backend/.coverage
backend/.coverage.*
backend/htmlcov/
# Результаты нагрузочных прогонов (CSV локального запуска)
backend/loadtest/results/

