# База API. По умолчанию прод (см. src/api/client.ts). Локально можно указать свой.
VITE_API_BASE=https://yulbash.ru

# Имя Telegram-бота для входа по коду (без @). Тот же бот, что в мобильном приложении.
# Пусто → кнопка «Войти через Telegram» покажет спокойную заглушку «скоро».
VITE_TELEGRAM_BOT=

# Ключ Яндекс Карт (JS API), выпускается в кабинете Яндекса ОТДЕЛЬНО под веб-домен
# app.yulbash.ru (не тот же, что нативный MapKit в Android). Пусто → карта покажет
# аккуратный брендовый плейсхолдер «Карта подключится с ключом» (экран не ломается).
VITE_YANDEX_MAPS_JS_KEY=
