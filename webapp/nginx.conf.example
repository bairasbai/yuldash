# ================================================================
#  Юлдаш PWA — пример прод-конфига nginx для app.yulbash.ru.
#  Статика из dist/ (результат `npm run build`), SPA-fallback на
#  index.html, агрессивный кеш для хешированных assets и НЕ-кеш для
#  service worker / манифеста / index.html. HTTPS обязателен (PWA/SW).
#
#  Скопируй в /etc/nginx/sites-available/app.yulbash.ru, поправь пути и
#  пути к сертификатам, затем: nginx -t && systemctl reload nginx
# ================================================================

# HTTP → HTTPS редирект
server {
    listen 80;
    listen [::]:80;
    server_name app.yulbash.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.yulbash.ru;

    # --- TLS (Let's Encrypt / certbot) ---
    ssl_certificate     /etc/letsencrypt/live/app.yulbash.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.yulbash.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # --- Security-заголовки (P1-2) ---
    # `always` — отдаём и на ошибках. Внимание (nginx-quirk): add_header в location НЕ наследует
    # серверные, поэтому в location =/index.html они продублированы (главный HTML обязан нести CSP).
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
    # CSP: свой origin + API (yulbash.ru) + Яндекс.Карты (внешний скрипт). При выкатке откалибровать
    # под реальные хосты карт/тайлов; style-src 'unsafe-inline' — минимально необходимое.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://yulbash.ru; script-src 'self' https://api-maps.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;

    # Каталог со собранной статикой (dist/)
    root  /var/www/yuldash-webapp/dist;
    index index.html;

    # Сжатие
    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- Хешированные assets (assets/index-XX␣.js|css) — можно кешировать навсегда ---
    # Имена меняются при каждой сборке, поэтому immutable безопасен.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # --- Service worker и обработчик пушей — НИКОГДА не кешировать ---
    # Иначе устройство застрянет на старом SW и не получит обновление.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location = /push-sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        types { } default_type application/manifest+json;
    }

    # --- SPA: все клиентские маршруты отдаём index.html ---
    # index.html тоже не кешируем, чтобы новая сборка подхватывалась сразу.
    location / {
        try_files $uri $uri/ /index.html;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        # nginx-quirk: location со своим add_header не наследует серверные → дублируем security.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://yulbash.ru; script-src 'self' https://api-maps.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
    }
}
